<?xml version="1.0" encoding="utf-8"?>
<!-- One family so React Native's fontWeight picks the right cut (registered in MainApplication). -->
<font-family xmlns:app="http://schemas.android.com/apk/res-auto">
    <font app:font="@font/hind_madurai_regular" app:fontStyle="normal" app:fontWeight="400" />
    <font app:font="@font/hind_madurai_medium" app:fontStyle="normal" app:fontWeight="500" />
    <font app:font="@font/hind_madurai_semibold" app:fontStyle="normal" app:fontWeight="600" />
    <font app:font="@font/hind_madurai_bold" app:fontStyle="normal" app:fontWeight="700" />
</font-family>
